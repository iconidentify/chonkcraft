<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.chonkbase.chonkcraft</groupId>
        <artifactId>chonkcraft-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>chonkcraft-data</artifactId>
    <name>ChonkCraft Data Extractor</name>

    <!--
      Reads the Warcraft II archive, graphics, map, audio, and disc-image
      formats that ChonkCraft uses and exposes them to the asset-pack builder.
    -->

    <dependencies>
        <dependency>
            <groupId>net.chonkbase.chonkcraft</groupId>
            <artifactId>chonk-assetpack</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.inwc3</groupId>
            <artifactId>JMPQ3</artifactId>
            <exclusions>
                <!-- Read-only extraction needs neither writer-side compressor. -->
                <exclusion>
                    <groupId>com.github.eustas</groupId>
                    <artifactId>CafeUndZopfli</artifactId>
                </exclusion>
                <!-- BNE's 1999 archives use zlib/implode, not LZMA. -->
                <exclusion>
                    <groupId>org.tukaani</groupId>
                    <artifactId>xz</artifactId>
                </exclusion>
                <!-- Avoid installing a logging backend into the game. -->
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>1.7.31</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
